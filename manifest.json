{
  "manifest_version": 3,
  "name": "Wiki AI",
  "version": "0.3.0",
  "description": "Chat with an AI model about the Wikipedia article you're reading and the articles it links to.",
  "homepage_url": "https://github.com/salocin93/wiki-ai",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.wikipedia.org/*",
    "https://query.wikidata.org/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "Toggle Wiki AI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Toggle the Wiki AI sidebar"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wikipedia.org/wiki/*",
        "https://*.wikipedia.org/zh*/*",
        "https://*.wikipedia.org/sr*/*",
        "https://*.wikipedia.org/w/index.php*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/sidebar.css",
        "vendor/katex/katex.min.js",
        "vendor/katex/katex.min.css",
        "vendor/katex/fonts/*",
        "icons/mascot.svg",
        "icons/wordmark.svg"
      ],
      "matches": [
        "https://*.wikipedia.org/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
